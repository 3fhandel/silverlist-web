{
  "key": "dispoliste-fleisch-summen",
  "name": "Dispoliste Fleisch Summen",
  "description": "Erzeugung von Fleischbedarfszetteln mit Artikelsummen.",
  "export_source": "Disposition Aufträge",
  "export_instructions": "In SilverERP Disposition Aufträge öffnen und die angezeigte Liste als CSV exportieren.",
  "required_columns": [
    "Einheit",
    "Bezeichnung 1",
    "Pos.-Netto",
    "Tour",
    "W.-Termin",
    "Beleg-Nr.",
    "Kunden-Nr.",
    "Name 1",
    "Artikel-Nr.",
    "Menge",
    "Disponierbarer Bestand",
    "S-Einheit",
    "Reserviert",
    "Zur Kommission freigegebene Menge",
    "Kommissioniert",
    "Termin",
    "B.-Termin",
    "E.-Termin",
    "Bezeichnung 2",
    "Versandart",
    "WG-Code",
    "WG Bezeichnung 1",
    "Bestand",
    "Status",
    "Beleg-Datum",
    "Referenz",
    "B.-Netto",
    "B.-MwSt.",
    "B.-Brutto",
    "Bestell-Nr.",
    "Bestelldatum",
    "Kurztext 1",
    "Kurztext 2",
    "Kurztext 3",
    "Ort",
    "Suchbegriff",
    "Name 2",
    "Straße",
    "Land",
    "PLZ",
    "Telefon",
    "Auftrags-Status"
  ],
  "query": "SELECT `Artikel-Nr.`, ANY_VALUE(`Bezeichnung 1`) AS Bezeichnung,\n        SUM(CAST(REPLACE(Menge, ',', '.') AS DOUBLE)) AS Menge, `Einheit`\n        FROM data WHERE `Artikel-Nr.` LIKE '20-%' OR `Artikel-Nr.` LIKE '30-%'\n        GROUP BY `Artikel-Nr.`, `Einheit` ORDER BY `Artikel-Nr.`, `Einheit`",
  "renderer": "generic-table",
  "variables": [
    {
      "name": "title",
      "type": "constant",
      "label": "title",
      "value": "Fleischzettel"
    },
    {
      "name": "letzteAfNummer",
      "type": "sql",
      "label": "letzteAfNummer",
      "query": "SELECT MAX(`Beleg-Nr.`) FROM data"
    },
    {
      "name": "subtitle",
      "type": "autoit",
      "label": "subtitle",
      "command": "'Letzte Auftragsnummer {{ letzteAfNummer }}, Export-Zeitstempel: ' & @MDAY & '.' & @MON & '.' & @YEAR & ', ' & @HOUR & ':' & @MIN & ':' & @SEC"
    }
  ],
  "additional_sources": [],
  "groups": [],
  "options": {
    "show_header": true,
    "show_page_numbers": true,
    "compact_margins": false,
    "legacy_template": "templates/tableIntern.html",
    "layout": "internal-table"
  },
  "legacy_source": "dispoliste_fleisch_summen.rpt"
}
