{
  "key": "bestellliste",
  "name": "Reguläre Bestellliste",
  "description": "Bestellliste mit VK1-6 oder Frischemarkt VK.",
  "export_source": "Stammdaten / Artikellisten",
  "export_instructions": "In SilverERP Stammdaten / Artikellisten öffnen und die angezeigte Liste als CSV exportieren.",
  "required_columns": [
    "Artikel-Nr.",
    "Suchbegriff",
    "Bezeichnung 1",
    "Bezeichnung 2",
    "Bestand",
    "S-Einheit",
    "V-Einheit",
    "Bedarf",
    "Bestellt",
    "Bezeichnung 3",
    "Warengruppe",
    "Bezeichnung 4",
    "EK-Einheit",
    "VK-Einheit",
    "Prüfbestand",
    "Sperrbestand",
    "PE",
    "VE",
    "EK-Kalk",
    "EK-Mittel",
    "Letzter EK",
    "Datum letzter EK",
    "Hersteller",
    "Herstellernummer",
    "Zeichnungs-Nr.",
    "Version",
    "Bauform",
    "Werkstoff",
    "Qualität",
    "UL-Nummer",
    "DIN-Norm",
    "Nettogewicht",
    "Bruttogewicht",
    "Dichte",
    "Länge",
    "Breite",
    "Stärke",
    "Abmessungen-Einheit",
    "Durchmesser-innen",
    "Durchmesser-außen",
    "Volumen",
    "GTIN/EANCode",
    "Ursprungsland",
    "Zolltarif-Nr.",
    "Intratstat",
    "Präferenzbegünstigt",
    "Skontofähig",
    "Provisionsfähig",
    "Provisionssatz",
    "Wiederbeschaffungszeit",
    "Dispo-Kennzeichen",
    "Zusatzinfo 1",
    "Zusatzinfo 2",
    "Zusatzinfo 3",
    "Archiv Artikel",
    "{PG:}",
    "{PG:VK1}",
    "{PG:VK2}",
    "{PG:VK3}",
    "{PG:VK4}",
    "{PG:VK5}",
    "{PG:VK6}",
    "{PG:VK7}",
    "{PG:VK8}"
  ],
  "query": "SELECT `Artikel-Nr.`, `Bezeichnung 1` AS Bezeichnung, `S-Einheit` AS Einheit,\n        CASE {{ preisgruppe }} WHEN '{PG:VK1}' THEN `{PG:VK1}` WHEN '{PG:VK2}' THEN `{PG:VK2}` END AS Preis,\n        '' AS Menge FROM data WHERE `Archiv Artikel` != '1'",
  "renderer": "generic-table",
  "variables": [
    {
      "name": "title",
      "type": "constant",
      "label": "title",
      "value": "Artikelpreisliste"
    },
    {
      "name": "subtitle",
      "type": "constant",
      "label": "subtitle",
      "value": "bla"
    },
    {
      "name": "preisgruppe",
      "type": "userSelect",
      "label": "VK-Schiene?",
      "selectFrom": [
        {
          "text": "VK 1",
          "value": "{PG:VK1}"
        },
        {
          "text": "VK 2",
          "value": "{PG:VK2}"
        }
      ]
    }
  ],
  "additional_sources": [],
  "groups": [],
  "options": {
    "show_header": true,
    "show_page_numbers": true,
    "compact_margins": false,
    "legacy_template": "templates/tableWithHeader.html",
    "layout": "branded-table"
  },
  "legacy_source": "bestellliste.rpt"
}
