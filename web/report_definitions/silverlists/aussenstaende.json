{
  "key": "aussenstaende",
  "name": "Außenstände",
  "description": "Außenstände mit Kundensummen",
  "export_source": "Controlling / Außenstände",
  "export_instructions": "In SilverERP Controlling / Außenstände öffnen und die angezeigte Liste als CSV exportieren.",
  "required_columns": [
    "Beleg-Nr.",
    "Datum",
    "Status",
    "Suchbegriff",
    "Kunden-Nr.",
    "Referenz",
    "Netto",
    "Brutto",
    "Offen",
    "Fälligkeit",
    "Mahnstufe",
    "Bestell-Nr.",
    "Bestelldatum",
    "Kurztext 1",
    "Kurztext 2",
    "Kurztext 3",
    "Name 1",
    "Name 2",
    "Land",
    "PLZ",
    "Ort",
    "Telefon 1",
    "Straße"
  ],
  "query": "SELECT '[' || `Kunden-Nr.` || '] ' || `Name 1` || ' (Σ = ' || \n\t\t\t(SELECT SUM(CAST(REPLACE(`Brutto`, ',', '.') AS DOUBLE)) FROM data d2 WHERE d2.`Kunden-Nr.` = data.`Kunden-Nr.`) || ')' AS KID, \n\t\t`Beleg-Nr.`, `Brutto`, `Datum`, `Fälligkeit`, `Mahnstufe`\n        FROM data\n\t\tORDER BY KID",
  "renderer": "grouped-table",
  "variables": [
    {
      "name": "vertreter",
      "type": "userText",
      "label": "Vertreter:"
    },
    {
      "name": "title",
      "type": "constant",
      "label": "title",
      "value": "Außenstände nach Vertreter {{ vertreter }}"
    },
    {
      "name": "subtitle",
      "type": "autoit",
      "label": "subtitle",
      "command": "'Export-Zeitstempel: ' & @MDAY & '.' & @MON & '.' & @YEAR & ', ' & @HOUR & ':' & @MIN & ':' & @SEC"
    }
  ],
  "additional_sources": [],
  "groups": [
    {
      "column": "KID",
      "show_column": false,
      "page_break": false,
      "repeat_header": false
    }
  ],
  "options": {
    "show_header": true,
    "show_page_numbers": true,
    "compact_margins": false,
    "legacy_template": "templates/tableIntern.html",
    "layout": "internal-table"
  },
  "legacy_source": "aussenstaende.rpt"
}
