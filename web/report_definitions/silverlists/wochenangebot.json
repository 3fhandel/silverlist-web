{
  "key": "wochenangebot",
  "name": "Wochenangebot",
  "description": "Wochenangebot für Mail- und Postversand.",
  "export_source": "Stammdaten / Preislisten-Definition",
  "export_instructions": "In SilverERP Stammdaten / Preislisten-Definition öffnen und die angezeigte Liste als CSV exportieren.",
  "required_columns": [
    "Artikel-Nr.",
    "Warengruppe",
    "Preis",
    "Währung",
    "Rabatt",
    "Ab Menge",
    "S.-Einheit",
    "Bezeichnung 1",
    "Bezeichnung 2",
    "Suchbegriff",
    "Gültig ab",
    "Gültig bis",
    "Archiv Artikel"
  ],
  "query": "SELECT `Artikel-Nr.`, `Bezeichnung 1` AS Bezeichnung, `S.-Einheit` AS Einheit,\n\t\t`Preis` AS 'E-Preis', ' ____________ ' AS Menge FROM data WHERE `Archiv Artikel` != 1",
  "renderer": "generic-table",
  "variables": [
    {
      "name": "datumVon",
      "type": "userText",
      "label": "Datum von:"
    },
    {
      "name": "datumBis",
      "type": "userText",
      "label": "Datum bis:"
    },
    {
      "name": "title",
      "type": "constant",
      "label": "title",
      "value": "Wochenangebot"
    },
    {
      "name": "subtitle",
      "type": "constant",
      "label": "subtitle",
      "value": "Angebote gültig von {{ datumVon }} bis {{ datumBis }}"
    }
  ],
  "additional_sources": [],
  "groups": [],
  "options": {
    "show_header": true,
    "show_page_numbers": true,
    "compact_margins": false,
    "legacy_template": "templates/tableWithHeader.html",
    "layout": "branded-table"
  },
  "legacy_source": "wochenangebot.rpt"
}
