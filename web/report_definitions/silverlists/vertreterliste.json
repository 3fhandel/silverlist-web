{
  "key": "vertreterliste",
  "name": "Vertreterumsatzliste",
  "description": "Vertreterliste mit Summe im Kopftext",
  "export_source": "Controlling / Kunden-Umsatz-Monat / Auswertung",
  "export_instructions": "In SilverERP Controlling / Kunden-Umsatz-Monat / Auswertung öffnen und die angezeigte Liste als CSV exportieren.",
  "required_columns": [
    "Suchbegriff",
    "Kunden-Nr.",
    "Menge",
    "Umsatz",
    "Rohgewinn",
    "Name 1",
    "Name 2",
    "Land",
    "PLZ",
    "Ort",
    "Telefon 1",
    "Straße",
    "Jahr",
    "Monat"
  ],
  "query": "SELECT `Kunden-Nr.`, `Name 1`, `Name 2`, `PLZ`, `Ort`, `Umsatz` AS Umsatz FROM data",
  "renderer": "generic-table",
  "variables": [
    {
      "name": "vertName",
      "type": "userText",
      "label": "Vertretername:"
    },
    {
      "name": "zeitraum",
      "type": "sql",
      "label": "zeitraum",
      "query": "SELECT `Monat` || '/' || `Jahr` FROM data"
    },
    {
      "name": "summe",
      "type": "sql",
      "label": "summe",
      "query": "SELECT REPLACE(CAST(SUM(CAST(REPLACE(REPLACE(`Umsatz`, '.', ''), ',', '.') AS DOUBLE)) AS VARCHAR), '.', ',') FROM data"
    },
    {
      "name": "title",
      "type": "constant",
      "label": "title",
      "value": "Vertreterumsatzliste {{ zeitraum }}"
    },
    {
      "name": "subtitle",
      "type": "constant",
      "label": "subtitle",
      "value": "Umsätze der Kunden des Vertreters {{ vertName }}.\nSumme: {{ summe }} €"
    }
  ],
  "additional_sources": [],
  "groups": [],
  "options": {
    "show_header": true,
    "show_page_numbers": true,
    "compact_margins": false,
    "legacy_template": "templates/tableWithHeader.html",
    "layout": "branded-table"
  },
  "legacy_source": "vertreterliste.rpt"
}
