  "query": "SELECT *, ROUND(DatevBetrag - SilverBetrag, 2) AS Differenz FROM (\n        SELECT `Belegfeld 1` AS Rechnungsnummer,\n        SUM((CASE `Soll/Haben-Kennzeichen` WHEN 'S' THEN 1 ELSE -1 END) * CAST(REPLACE(`Umsatz (ohne Soll/Haben-Kz)`, ',', '.') AS DOUBLE)) AS DatevBetrag,\n        ANY_VALUE(CAST(REPLACE(REPLACE(silver.`B.-Brutto`, '.', ''), ',', '.') AS DOUBLE)) AS SilverBetrag\n        FROM data LEFT JOIN silver ON silver.`Beleg-Nr.` = data.`Belegfeld 1`\n        GROUP BY `Belegfeld 1`) comparison\n        WHERE (DatevBetrag - SilverBetrag) < 0.01 ORDER BY Differenz",
  "renderer": "generic-table",
  "variables": [
    {
      "name": "umsSilver",
      "type": "sql",
      "label": "umsSilver",
      "query": "SELECT SUM(CAST(REPLACE(REPLACE(`B.-Brutto`, '.', ''), ',', '.') AS DOUBLE)) FROM silver"
    },
    {
      "name": "umsDatev",
      "type": "sql",
      "label": "umsDatev",
      "query": "SELECT SUM((CASE `Soll/Haben-Kennzeichen` WHEN 'S' THEN 1 ELSE -1 END) * CAST(REPLACE(`Umsatz (ohne Soll/Haben-Kz)`, ',', '.') AS DOUBLE)) FROM data"
    },
    {
      "name": "title",
      "type": "constant",
      "label": "title",
      "value": "Rechnungsdifferenzen"
    },
    {
      "name": "subtitle",
      "type": "constant",
      "label": "subtitle",
      "value": "SilverERP-Summe: {{ umsSilver }}        DATEV-Summe: {{ umsDatev }}"
    }
  ],
